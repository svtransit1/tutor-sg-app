{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tutor-SG Question Bank",
  "description": "MOE-syllabus-aligned question corpus for Singapore primary school (P1-P6). All questions are originally authored, bilingual (EN + zh-Hans), and mapped to topic taxonomy nodes.",
  "type": "object",
  "required": ["version", "metadata", "topics", "questions"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver for this corpus version"
    },
    "metadata": {
      "type": "object",
      "required": ["generated_at", "source", "total_questions", "total_topics"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "source": {
          "type": "string",
          "description": "Content source reference, e.g. 'MOE Primary Syllabus PDFs (public Crown Copyright)'"
        },
        "copyright_notice": {
          "type": "string",
          "description": "Legal notice for this corpus"
        },
        "total_questions": { "type": "integer", "minimum": 1 },
        "total_topics": { "type": "integer", "minimum": 1 }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["topic_id", "level", "subject", "name_en", "name_zh"],
        "properties": {
          "topic_id": { "type": "string", "pattern": "^[A-Z]{3}-P\\d-\\d{3}$" },
          "level": { "type": "integer", "minimum": 1, "maximum": 6, "description": "Primary level P1-P6" },
          "subject": { "type": "string", "enum": ["math", "english", "science", "chinese"] },
          "name_en": { "type": "string" },
          "name_zh": { "type": "string" },
          "description_en": { "type": "string" },
          "description_zh": { "type": "string" },
          "learning_outcomes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "parent_topic_id": {
            "type": ["string", "null"],
            "description": "References another topic_id for hierarchy, null for root topics"
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id", "topic_id", "level", "subject", "question_type",
          "stem_en", "stem_zh", "difficulty"
        ],
        "properties": {
          "question_id": { "type": "string", "pattern": "^Q-[A-Z]{3}-P\\d-\\d{4}$" },
          "topic_id": { "type": "string", "pattern": "^[A-Z]{3}-P\\d-\\d{3}$" },
          "level": { "type": "integer", "minimum": 1, "maximum": 6 },
          "subject": { "type": "string", "enum": ["math", "english", "science", "chinese"] },
          "question_type": {
            "type": "string",
            "enum": [
              "multiple_choice", "fill_in_blank", "short_answer",
              "structured", "open_ended", "oral", "composition",
              "comprehension", "dictation", "cloze", "sentence_formation",
              "picture_description", "stroke_order"
            ]
          },
          "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
          "stem_en": { "type": "string", "description": "Question stem in English" },
          "stem_zh": { "type": "string", "description": "Question stem in Simplified Chinese" },
          "options": {
            "type": "array",
            "description": "For multiple_choice: array of {label, text_en, text_zh}",
            "items": {
              "type": "object",
              "required": ["label", "text_en", "text_zh"],
              "properties": {
                "label": { "type": "string" },
                "text_en": { "type": "string" },
                "text_zh": { "type": "string" }
              }
            }
          },
          "answer_en": { "type": "string", "description": "Correct answer in English" },
          "answer_zh": { "type": "string", "description": "Correct answer in Simplified Chinese" },
          "explanation_en": { "type": "string", "description": "Explanation/solution in English" },
          "explanation_zh": { "type": "string", "description": "Explanation/solution in Simplified Chinese" },
          "hints": {
            "type": "array",
            "description": "Progressive hints (hint first, answer last)",
            "items": {
              "type": "object",
              "properties": {
                "text_en": { "type": "string" },
                "text_zh": { "type": "string" },
                "step": { "type": "integer", "minimum": 1 }
              }
            }
          },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Free-form tags for filtering, e.g. ['psle-format', 'voice-first', 'oral-practice']"
          },
          "moed_code": {
            "type": "string",
            "description": "MOE syllabus topic code reference, e.g. 'M-P3-N-01'"
          }
        }
      }
    }
  }
}
