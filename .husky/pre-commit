[ "$CI" = "true" ] && exit 0

staged_ts=$(git diff --cached --name-only --diff-filter=ACM | grep -cE '\.(ts|tsx)$' || true)
[ "$staged_ts" -eq 0 ] && exit 0

affected=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(ts|tsx)$' \
  | sed -n 's|^\(packages/[^/]*\).*|\1|p; s|^mobile/.*|mobile|p' \
  | sort -u)

for dir in $affected; do
  case "$dir" in
    packages/*) filter="./$dir" ;;
    mobile) filter="tutor-sg-mobile" ;;
  esac
  pnpm --filter "$filter" lint || exit 1
  pnpm --filter "$filter" typecheck || exit 1
done
