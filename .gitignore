# Secrets
.env
.env.*
!.env.example
*.pem
*.p12
*.keystore

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Dependencies (will populate after framework decision)
node_modules/
**/Pods/
.gradle/

# Only pnpm lockfile is allowed — reject npm/yarn lockfiles
package-lock.json
yarn.lock
yarn-error.log
npm-shrinkwrap.json

# Build outputs
build/
dist/
*.ipa
*.apk
*.aab
*.app

# Local LLM model artefacts — never commit
**/models/
*.tflite
*.litertlm
*.gguf
# Exception: shared package models dir (integrity manifest)
!packages/shared/src/models/
# Only track JSON manifests, not actual model weights
packages/shared/src/models/*
!packages/shared/src/models/*.json

# Test outputs
coverage/
.nyc_output/

# Child-safe rule: NEVER commit anything from real users
private/
sample-data/
*.heic

# pnpm lockfile is version-controlled (see pnpm-workspace.yaml) — keep it tracked
# (pnpm-lock.yaml is NOT gitignored; only package-lock.json / yarn.lock are)
