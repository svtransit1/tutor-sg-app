# tutor-sg — Environment Variables (copy to .env.local or set in CI)
# ==============================================================================
# NEVER commit the actual .env file. This file is the template.
#
# Copy:   cp .env.example .env.local  (for local dev)
# Set in: GitHub Actions secrets / EAS Secrets / your shell profile
#
# Required for EAS Build + Submit
# ==============================================================================

# ── EAS Project ──────────────────────────────────────────────────────────────
# Created via `eas init` or `eas project:init`. Set once and share across team.
EAS_PROJECT_ID=

# ── iOS App Store Connect ────────────────────────────────────────────────────
# Apple ID email used for App Store Connect + Apple Developer
EAS_APPLE_ID=
# App-specific password (generate at appleid.apple.com → App-Specific Passwords)
# Needed when appleId is set in submit profile.
EAS_APPLE_APP_SPECIFIC_PASSWORD=
# Your Apple Developer Team ID (10-digit alphanumeric, find at developer.apple.com)
EAS_APPLE_TEAM_ID=
# The Apple App Store Connect App ID (numeric, ascAppId). Not the bundle ID.
# Find via App Store Connect → My Apps → your app → App Information → Apple ID
ASC_APPLE_ID=PLACEHOLDER_REPLACE_ME
# Alternative: Use App Store Connect API Key instead of appleId (recommended for CI).
# Generate at App Store Connect → Users and Access → Keys → App Store Connect API
# EAS_ASC_API_KEY_ID=
# EAS_ASC_API_KEY_ISSUER_ID=
# EAS_ASC_API_KEY_PATH=

# ── Android Google Play Console ──────────────────────────────────────────────
# Path to the Google Play service account JSON key file.
# Generate at Google Play Console → Setup → API access → Service account → Create key
EAS_ANDROID_SERVICE_ACCOUNT_KEY_PATH=
# Google Play Console track for submission
# Options: production, beta, alpha, internal
# EAS_ANDROID_TRACK=production
