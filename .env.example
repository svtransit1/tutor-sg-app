# tutor-sg Environment Variables (root)
# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase (all environments — override via EAS profile envs or local .env.local)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# EAS Project ID (from expo.dev project settings)
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
