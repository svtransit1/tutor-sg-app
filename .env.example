# =============================================================================
# tutor-sg Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
#   cp .env.example .env.local
#
# For EAS Build / CI, configure secrets via:
#   - GitHub Actions Secrets (repo Settings → Secrets and variables → Actions)
#   - EAS Secrets (eas secret:create)
#
# Convention:
#   EXPO_PUBLIC_*  → bundled into the app binary, visible on device.
#                     Safe for CDN URLs, Supabase anon key, feature flags.
#   Everything else → server-side or build-time only.
#                     NEVER use raw secret values with EXPO_PUBLIC_ prefix.
# =============================================================================

# ---- App environment --------------------------------------------------------
# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# ---- CDN (Cloudflare R2) ----------------------------------------------------
# Base URL for model artifact downloads. Must end with /.
EXPO_PUBLIC_CDN_BASE_URL=https://cdn.example.com/models/

# Override the model index path (default: index.json).
# EXPO_PUBLIC_MODEL_INDEX_PATH=index.json

# ---- Supabase ---------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ---- HitPay (payments) ------------------------------------------------------
EXPO_PUBLIC_HITPAY_API_KEY=your-hitpay-public-key-here

# ---- Dev tools --------------------------------------------------------------
# Set to true to enable developer overlay, debug menus, etc.
# Automatically forced to false in production builds.
EXPO_PUBLIC_ENABLE_DEV_TOOLS=false

# ---- Log level --------------------------------------------------------------
# debug | info | warn | error
# Default: info in dev, warn in production.
# EXPO_PUBLIC_LOG_LEVEL=info

# =============================================================================
# SECRETS (never prefix with EXPO_PUBLIC_)
# Configure these via EAS Secrets or GitHub Actions Secrets — NOT in .env files.
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY   — service_role key for admin operations
# HITPAY_SECRET_KEY           — HitPay secret API key
# HITPAY_WEBHOOK_SECRET       — HitPay webhook verification secret
