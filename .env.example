# =============================================================================
# tutor-sg — Environment Variables
# =============================================================================
#
# 📋 How to use this file
#
#   1. Copy this file to `.env.local` for local development:
#        cp .env.example .env.local
#
#   2. Fill in real values in `.env.local` — NEVER commit `.env.local`
#      or any `.env.*` file that contains real secrets.
#
#   3. For EAS Build / CI, see `docs/SECRETS.md` for platform-specific
#      setup instructions (EAS Secrets, GitHub Actions Secrets, etc.).
#
# =============================================================================
# 🔑 Convention
# =============================================================================
#
#   EXPO_PUBLIC_*  →  Bundled into the app binary, visible on device.
#                      Safe for CDN URLs, Supabase anon key, feature flags.
#
#   (no prefix)    →  Build-time or server-side only.
#                      NEVER expose raw secret values with EXPO_PUBLIC_ prefix.
#
# =============================================================================
# 🏗️ App environment
# =============================================================================

# One of: development | staging | production
# Controls feature flags, API endpoints, and logging behaviour.
EXPO_PUBLIC_APP_ENV=development

# =============================================================================
# ☁️ CDN (Cloudflare R2) — model artifact downloads
# =============================================================================

# Base URL for model artifact downloads. Must end with /.
EXPO_PUBLIC_CDN_BASE_URL=https://cdn.example.com/models/

# Optional: Override the model manifest path relative to CDN_BASE_URL.
# Defaults to "index.json".
# EXPO_PUBLIC_MODEL_INDEX_PATH=index.json

# =============================================================================
# 🗄️ Supabase — auth, billing webhooks, parent dashboard sync
# =============================================================================

EXPO_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# 💳 HitPay — payments (Apple Pay, Google Pay, PayNow)
# =============================================================================

# Public (publishable) API key for client-side payment initialisation.
EXPO_PUBLIC_HITPAY_API_KEY=your-hitpay-public-key-here

# =============================================================================
# 🛠️ Developer tools
# =============================================================================

# Set to "true" to enable developer overlay, debug menus, and experimental
# features in non-production builds.
# Automatically forced to "false" in production builds regardless of value.
EXPO_PUBLIC_ENABLE_DEV_TOOLS=false

# =============================================================================
# 📝 Logging
# =============================================================================

# One of: debug | info | warn | error
# Default: info in development, warn in production builds.
# EXPO_PUBLIC_LOG_LEVEL=info

# =============================================================================
# 🔒 SECRETS — NEVER prefix with EXPO_PUBLIC_
# =============================================================================
#
# The following secrets are used at build time or server-side only.
# They must NOT be set in `.env.local` — configure them via the platform
# specified in `docs/SECRETS.md`.
#
# ┌──────────────────────────────────┬─────────────────────────────────────────┐
# │ Variable                         │ Where to configure                     │
# ├──────────────────────────────────┼─────────────────────────────────────────┤
# │ SUPABASE_SERVICE_ROLE_KEY        │ EAS Secrets / GitHub Actions Secrets   │
# │ HITPAY_SECRET_KEY                │ EAS Secrets / GitHub Actions Secrets   │
# │ HITPAY_WEBHOOK_SECRET            │ EAS Secrets / GitHub Actions Secrets   │
# │ IOS_APP_STORE_CONNECT_API_KEY    │ EAS Secrets (EAS Submit)               │
# │ ANDROID_KEYSTORE_PASSWORD        │ EAS Secrets (EAS Build)                │
# └──────────────────────────────────┴─────────────────────────────────────────┘
#
# See docs/SECRETS.md for step-by-step configuration of each secret,
# including EAS CLI commands and GitHub Actions setup.
