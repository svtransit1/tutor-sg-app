{
  "name": "tutor-sg",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:ios": "pnpm install && pnpm --filter tutor-sg-mobile ios",
    "dev:android": "pnpm install && pnpm --filter tutor-sg-mobile android",
    "bootstrap": "./scripts/bootstrap.sh",
    "mobile": "npm run --workspace=mobile",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:mobile": "cd mobile && pnpm exec jest --passWithNoTests --maxWorkers=2",
    "test:shared": "cd packages/shared && pnpm exec jest --passWithNoTests --maxWorkers=2",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:watch": "pnpm --recursive typecheck:watch",
    "mobile:start": "pnpm --filter tutor-sg-mobile start",
    "mobile:ios": "pnpm --filter tutor-sg-mobile ios",
    "mobile:android": "pnpm --filter tutor-sg-mobile android",
    "eas:build:android:internal": "cd mobile && pnpm eas:build:android:internal",
    "eas:build:android:internal-aab": "cd mobile && pnpm eas:build:android:internal-aab"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "react-test-renderer": "^19.2.6",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "expo-speech": "~14.0.8"
  }
}
