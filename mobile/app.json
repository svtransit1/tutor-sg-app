{
  "expo": {
    "name": "Tutor SG",
    "slug": "tutor-sg",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tutor-sg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aaas.tutorsg",
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "NSCameraUsageDescription": "Tutor SG needs camera access to scan homework questions.",
        "NSMicrophoneUsageDescription": "Tutor SG needs microphone access for voice input."
      }
    },
    "android": {
      "adaptiveIcon": { "backgroundColor": "#4A90D9" },
      "package": "com.aaas.tutorsg",
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"]
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": { "typedRoutes": true }
  }
}
