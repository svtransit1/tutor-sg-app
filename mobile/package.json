{
  "name": "tutor-sg-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "RNTL_SKIP_DEPS_CHECK=true pnpm exec jest --passWithNoTests --maxWorkers=2",
    "eas:build:dev": "eas build --platform all --profile development --non-interactive",
    "eas:build:dev:ios": "eas build --platform ios --profile development --non-interactive",
    "eas:build:dev:android": "eas build --platform android --profile development --non-interactive",
    "eas:build:preview": "eas build --platform all --profile preview --non-interactive",
    "eas:build:preview:aab": "eas build --platform android --profile preview-aab --non-interactive",
    "eas:build:production": "eas build --platform all --profile production --non-interactive",
    "eas:submit:production": "eas submit --platform all --profile production --non-interactive"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-localization": "~17.0.0",
    "expo-router": "~6.0.0",
    "expo-linking": "~8.0.12",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "i18next": "^25.0.0",
    "react-i18next": "^16.0.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "typescript": "^5.8.0",
    "react": "19.1.0"
  },
  "engines": {
    "node": ">=25.9.0",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.0",
    "@types/node": "^25.6.2",
    "@types/react": "~19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react": "^19.1.0",
    "react-dom": "19.1.0",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.9"
  }
}
