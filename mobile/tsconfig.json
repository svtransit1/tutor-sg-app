{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "lib": ["DOM", "ESNext"],
    "allowJs": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "customConditions": ["react-native"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "app/_layout.tsx", "app/index.tsx",
    "app/(kid)/_layout.tsx",
    "app/(onboarding)/_layout.tsx",
    "app/(parent)/_layout.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
