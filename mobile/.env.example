# =============================================================================
# tutor-sg — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
#
# ALL variables accessible in the client JS bundle MUST be prefixed with
# EXPO_PUBLIC_.  Non-prefixed vars are server/build-time only.
#
# Per ADD §6.1: NO child data (photos, OCR text, kid free-text) leaves the
# device.  Supabase handles only parent auth + IAP receipt validation + opt-in
# telemetry.  Model downloads come from Cloudflare R2 CDN.
# =============================================================================

# ── Supabase (Auth + IAP validation + opt-in telemetry) ──────────────────
# Required for: parent sign-in, IAP receipt verification, telemetry sink.
# Used by: mobile/src/services/supabase.ts
EXPO_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Model CDN (Cloudflare R2) ────────────────────────────────────────────
# Required for: first-launch model download, model version upgrades.
# The app fetches {MODEL_CDN_URL}/index.json then downloads each model file
# with SHA-256 integrity verification.
# Used by: packages/llm (downloader)
EXPO_PUBLIC_MODEL_CDN_URL=https://<account-id>.r2.cloudflarestorage.com/tutor-sg-models
# Optional — only needed if R2 bucket requires signed URLs.
# EXPO_PUBLIC_MODEL_CDN_API_TOKEN=

# ── HitPay (Billing) ─────────────────────────────────────────────────────
# Required for: IAP processing via HitPay (Apple Pay, Google Pay, PayNow).
# Used by: mobile/src/services/billing (M6 milestone)
EXPO_PUBLIC_HITPAY_API_KEY=
# Server-side only — do NOT prefix with EXPO_PUBLIC.
# Used by Supabase Edge Function for webhook signature verification.
# HITPAY_WEBHOOK_SALT=

# ── Telemetry (opt-in) ───────────────────────────────────────────────────
# Required for: opt-in anonymized usage telemetry.
# Defaults to Supabase project if unset.
# EXPO_PUBLIC_TELEMETRY_ENDPOINT=

# ── App Environment ──────────────────────────────────────────────────────
# development | staging | production
# Controls: log verbosity, feature flags, CDN environment selection.
EXPO_PUBLIC_APP_ENV=development

# =============================================================================
# CI / EAS Build (set in GitHub Secrets or eas.json — NEVER commit)
# =============================================================================
# EXPO_TOKEN           — EAS CLI authentication token
# SENTRY_AUTH_TOKEN    — Sentry auth token (if using Sentry)
# SENTRY_ORG           — Sentry organisation slug
# SENTRY_PROJECT       — Sentry project slug
