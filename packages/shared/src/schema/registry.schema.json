{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": { "$ref": "#/definitions/ModelRegistryEntry" },
  "definitions": {
    "ModelRegistryEntry": {
      "type": "object",
      "required": [
        "modelFamily",
        "paramCount",
        "quant",
        "format",
        "sizeBytes",
        "sha256",
        "cdnUrls",
        "minDeviceTier"
      ],
      "properties": {
        "modelFamily": { "type": "string" },
        "paramCount": { "type": "number" },
        "quant": { "type": "string" },
        "format": { "type": "string" },
        "sizeBytes": { "type": "number" },
        "sha256": { "type": "string" },
        "cdnUrls": { "type": "array", "items": { "type": "string" } },
        "minDeviceTier": { "type": "string" },
        "iosOnly": { "type": "boolean" },
        "androidOnly": { "type": "boolean" },
        "recommended": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  }
}
